  "type": "object",
  "properties": {
    "provisioningState": {
      "type": "string"
    },
    "maxAgentPools": {
      "type": "integer"
    },
    "kubernetesVersion": {
      "type": "string"
    },
    "currentKubernetesVersion": {
      "type": "string"
    },
    "dnsPrefix": {
      "type": "string"
    },
    "fqdnSubdomain": {
      "type": "string"
    },
    "fqdn": {
      "type": "string"
    },
    "privateFQDN": {
      "type": "string"
    },
    "azurePortalFQDN": {
      "type": "string"
    },
